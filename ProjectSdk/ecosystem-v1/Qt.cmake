include_guard(GLOBAL)
find_package(Qt6 6.3 QUIET COMPONENTS Core Widgets Test)
if(NOT Qt6_FOUND)
    message(FATAL_ERROR "Native.Qt requires installed Qt 6.3+ with Core, Widgets, Test and moc/uic/rcc. Set Qt6_DIR or CMAKE_PREFIX_PATH. Considered Qt versions: ${Qt6_CONSIDERED_VERSIONS}")
endif()
macro(cmwf_qt_setup)
    qt_standard_project_setup()
    set(CMAKE_AUTORCC ON)
    set(_cmwf_qt_identity "${Qt6_VERSION}|${Qt6_DIR}")
    foreach(_cmwf_qt_file IN ITEMS "${Qt6_DIR}/Qt6Config.cmake" "${Qt6_DIR}/Qt6ConfigVersion.cmake")
        if(EXISTS "${_cmwf_qt_file}")
            file(SHA256 "${_cmwf_qt_file}" _cmwf_qt_sha)
            string(APPEND _cmwf_qt_identity "|${_cmwf_qt_sha}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cmwf_qt_file}")
        endif()
    endforeach()
    cmwf_sdk_dependency(Qt "${_cmwf_qt_identity}")
endmacro()
