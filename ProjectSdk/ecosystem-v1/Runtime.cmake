include_guard(GLOBAL)
option(CMWF_RUNTIME_THREADS "Protect the bounded queue with a mutex." ON)
function(cmwf_runtime_library target)
    set_target_properties(${target} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
    if(CMWF_RUNTIME_THREADS)
        find_package(Threads REQUIRED)
        target_link_libraries(${target} PRIVATE Threads::Threads)
        target_compile_definitions(${target} PRIVATE CMWF_RUNTIME_THREADS=1)
        set(CMWF_PACKAGE_REQUIREMENTS "include(CMakeFindDependencyMacro)\nfind_dependency(Threads)")
    endif()
    if(CMWF_VARIANT_INSTRUMENTED)
        cmwf_sdk_target(${target} PUBLIC)
        add_library(${target}::${target} ALIAS ${target})
    else()
        cmwf_sdk_library(${target})
    endif()
    cmwf_variant_apply(${target})
endfunction()
