include_guard(GLOBAL)

# The ordinary CMake presets leave these inputs unset.
if(NOT DEFINED CMWF_VARIANT_ID)
    function(cmwf_variant_apply target)
    endfunction()
    return()
endif()

if(NOT CMWF_VARIANT_ID MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Invalid CMakeWorkflow build variant identity")
endif()
if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "The selected build variant requires native compilation")
endif()
if(NOT CMWF_VARIANT_LINKAGE MATCHES "^(Default|Static|Shared)$"
    OR NOT CMWF_VARIANT_OPTIMIZATION MATCHES "^(Default|None|Speed|Size)$"
    OR NOT CMWF_VARIANT_DEBUG MATCHES "^(Default|Enabled|Disabled)$"
    OR NOT CMWF_VARIANT_LTO MATCHES "^(Default|Enabled|Disabled)$"
    OR NOT CMWF_VARIANT_INSTRUMENTATION MATCHES "^(None|Address|Undefined|AddressUndefined)$")
    message(FATAL_ERROR "Invalid CMakeWorkflow build variant policy")
endif()

if(NOT CMWF_VARIANT_LINKAGE STREQUAL "Default")
    string(TOUPPER "${CMWF_VARIANT_LINKAGE}" CMWF_VARIANT_LIBRARY_TYPE)
endif()

if(NOT CMWF_VARIANT_OPTIMIZATION STREQUAL "Default" OR NOT CMWF_VARIANT_DEBUG STREQUAL "Default")
    if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        set(_cmwf_optimization_None /Od)
        set(_cmwf_optimization_Speed /O2)
        set(_cmwf_optimization_Size /O1)
        set(_cmwf_debug_Enabled /Z7)
        if(CMWF_VARIANT_DEBUG STREQUAL "Disabled")
            message(FATAL_ERROR "Explicit debug information disabling is unavailable with the MSVC frontend")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
        set(_cmwf_optimization_None -O0)
        set(_cmwf_optimization_Speed -O3)
        set(_cmwf_optimization_Size -Os)
        set(_cmwf_debug_Enabled -g)
        set(_cmwf_debug_Disabled -g0)
    else()
        message(FATAL_ERROR "Unsupported compiler frontend for explicit optimization/debug settings")
    endif()
endif()

if(NOT CMWF_VARIANT_INSTRUMENTATION STREQUAL "None")
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
        OR CMAKE_CROSSCOMPILING OR CMWF_VARIANT_LTO STREQUAL "Enabled")
        message(FATAL_ERROR "Sanitizers require a native Linux GCC compiler and IPO disabled")
    endif()
    set(_cmwf_sanitizer_Address address)
    set(_cmwf_sanitizer_Undefined undefined)
    set(_cmwf_sanitizer_AddressUndefined address,undefined)
    set(_cmwf_sanitizer_flag "-fsanitize=${_cmwf_sanitizer_${CMWF_VARIANT_INSTRUMENTATION}}")
    set(CMWF_VARIANT_INSTRUMENTED TRUE)
    function(_cmwf_probe_sanitizer)
        include(CheckCXXSourceRuns)
        set(CMAKE_REQUIRED_FLAGS "${_cmwf_sanitizer_flag}")
        set(CMAKE_REQUIRED_LINK_OPTIONS "${_cmwf_sanitizer_flag}")
        unset(CMWF_SANITIZER_RUNS CACHE)
        check_cxx_source_runs("int main() { return 0; }" CMWF_SANITIZER_RUNS)
        if(NOT CMWF_SANITIZER_RUNS)
            message(FATAL_ERROR "Selected sanitizer failed its compiler, linker or runtime probe")
        endif()
    endfunction()
    _cmwf_probe_sanitizer()
endif()

set(_cmwf_ipo OFF)
if(CMWF_VARIANT_LTO STREQUAL "Enabled")
    include(CheckIPOSupported)
    check_ipo_supported(RESULT _cmwf_ipo OUTPUT _cmwf_ipo_diagnostic LANGUAGES CXX)
    if(NOT _cmwf_ipo)
        message(FATAL_ERROR "IPO unavailable: ${_cmwf_ipo_diagnostic}")
    endif()
endif()

function(cmwf_variant_apply target)
    if(NOT DEFINED CMWF_VARIANT_ID)
        return()
    endif()
    target_compile_options(${target} PRIVATE
        ${_cmwf_optimization_${CMWF_VARIANT_OPTIMIZATION}}
        ${_cmwf_debug_${CMWF_VARIANT_DEBUG}})
    if(CMWF_VARIANT_INSTRUMENTED)
        target_compile_options(${target} PRIVATE "${_cmwf_sanitizer_flag}" -fno-sanitize-recover=all)
        target_link_options(${target} PRIVATE "${_cmwf_sanitizer_flag}")
    endif()
    if(NOT CMWF_VARIANT_LTO STREQUAL "Default")
        set_target_properties(${target} PROPERTIES INTERPROCEDURAL_OPTIMIZATION ${_cmwf_ipo})
    endif()
    set(CMWF_VARIANT_APPLIED "${CMWF_VARIANT_ID}" CACHE INTERNAL "Applied build variant" FORCE)
endfunction()
