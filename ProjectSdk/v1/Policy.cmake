# P1 lock reader. Normal CMake builds do not need the CLI or a network.
# This is a consistency check for trusted project files, not a sandbox or signature.
function(cmwf_sdk_check_inputs lock field)
    string(JSON count LENGTH "${lock}" "${field}")
    if(count LESS 1)
        message(FATAL_ERROR "Empty SDK lock ${field}")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON relative MEMBER "${lock}" "${field}" ${index})
        if(NOT relative MATCHES "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" OR relative MATCHES "(^|/)\\.\\.?(/|$)")
            message(FATAL_ERROR "Unsafe SDK lock path: ${relative}")
        endif()
        set(path "${PROJECT_SOURCE_DIR}/${relative}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "Missing or invalid SDK input: ${relative}")
        endif()
        string(JSON expected GET "${lock}" "${field}" "${relative}")
        file(SHA256 "${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Stale SDK lock: ${relative}. Review project sdk plan and lock again.")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endforeach()
endfunction()

set(_cmwf_lock_path "${PROJECT_SOURCE_DIR}/cmwf.sdk.lock.json")
if(NOT EXISTS "${_cmwf_lock_path}")
    message(FATAL_ERROR "Missing SDK lock. Run project sdk plan and project sdk lock.")
endif()
file(READ "${_cmwf_lock_path}" _cmwf_lock)
string(JSON _cmwf_schema GET "${_cmwf_lock}" schemaVersion)
string(JSON _cmwf_version GET "${_cmwf_lock}" sdkVersion)
if(NOT _cmwf_schema STREQUAL "1" OR NOT _cmwf_version STREQUAL "1.1.0")
    message(FATAL_ERROR "Unsupported SDK lock schema or version")
endif()
# Require the manifest and all SDK modules to be present in the evidence map.
string(JSON _cmwf_manifest GET "${_cmwf_lock}" inputs "cmwf.project.json")
foreach(_cmwf_module IN ITEMS Native.cmake PackageConfig.cmake.in Policy.cmake Catalog.json)
    string(JSON _cmwf_module_digest GET "${_cmwf_lock}" modules "cmake/cmwf-sdk/v1/${_cmwf_module}")
endforeach()
cmwf_sdk_check_inputs("${_cmwf_lock}" inputs)
cmwf_sdk_check_inputs("${_cmwf_lock}" modules)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cmwf_lock_path}")
string(JSON CMWF_SDK_CXX_STANDARD GET "${_cmwf_lock}" effective cxxStandard)
string(JSON CMWF_SDK_CXX_EXTENSIONS GET "${_cmwf_lock}" effective cxxExtensions)
string(JSON CMWF_SDK_WARNINGS_AS_ERRORS GET "${_cmwf_lock}" effective warningsAsErrors)
if(NOT CMWF_SDK_CXX_STANDARD MATCHES "^(17|20|23)$")
    message(FATAL_ERROR "Unsupported SDK C++ standard")
endif()
