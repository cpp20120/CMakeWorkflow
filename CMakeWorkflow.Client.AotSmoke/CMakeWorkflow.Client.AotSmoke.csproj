<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup Condition="'$(SdkPackageVersion)' == ''">
    <ProjectReference Include="../CMakeWorkflow.Client/CMakeWorkflow.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SdkPackageVersion)' != ''">
    <PackageReference Include="CMakeWorkflow.Client" Version="$(SdkPackageVersion)" />
  </ItemGroup>
  <Target Name="RequirePackageOnlyConsumer" BeforeTargets="ResolveProjectReferences"
          Condition="'$(SdkPackageVersion)' != ''">
    <Error Condition="'@(ProjectReference)' != ''" Text="Packaged SDK smoke must not use ProjectReference: @(ProjectReference)" />
  </Target>
</Project>
