<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants Condition="'$(RecoveryFaultInjection)' == 'true'">$(DefineConstants);RECOVERY_FAULT_INJECTION</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CMakeWorkflow"/>
        <InternalsVisibleTo Include="CMakeWorkflow.Developer"/>
        <InternalsVisibleTo Include="CMakeWorkflow.Host.Tests"/>
        <InternalsVisibleTo Include="CMakeWorkflow.Host"/>
        <InternalsVisibleTo Include="CMakeWorkflow.Storage.Documents"/>
        <InternalsVisibleTo Include="CMakeWorkflow.Profiling"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="*.cs"/>
        <Compile Include="Artifacts/*.cs"/>
        <Compile Include="Build/*.cs"/>
        <EmbeddedResource Include="../ProjectSdk/ecosystem-v1/*" LogicalName="CMakeWorkflow.ProjectSdk.ecosystem-v1.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="../ProjectSdk/config-v1/Variant.cmake" LogicalName="CMakeWorkflow.Configuration.Variant.v1"/>
        <Compile Include="Execution/*.cs"/>
        <Compile Include="Planning/*.cs"/>
        <Compile Include="Recipes/*.cs"/>
        <Compile Include="Quality/*.cs"/>
        <Compile Include="Recovery/*.cs"/>
        <Compile Include="Reporting/*.cs"/>
        <Compile Include="Serialization/*.cs"/>
        <Compile Include="Toolchains/*.cs"/>
        <ProjectReference Include="../CMakeWorkflow.Binary.Capnp/CMakeWorkflow.Binary.Capnp.csproj"/>
        <ProjectReference Include="../CMakeWorkflow.Core/CMakeWorkflow.Core.csproj"/>
        <ProjectReference Include="../CMakeWorkflow.Contracts/CMakeWorkflow.Contracts.csproj"/>
        <ProjectReference Include="../CMakeWorkflow.Tooling/CMakeWorkflow.Tooling.csproj"/>
    </ItemGroup>
</Project>
