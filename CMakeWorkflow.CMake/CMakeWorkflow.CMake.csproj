<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants Condition="'$(RecoveryFaultInjection)' == 'true'">$(DefineConstants);RECOVERY_FAULT_INJECTION</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CMakeWorkflow.Host.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="*.cs"/>
        <Compile Include="Artifacts/*.cs"/>
        <Compile Include="Build/*.cs"/>
        <Compile Include="Execution/*.cs"/>
        <Compile Include="Planning/*.cs"/>
        <Compile Include="Recipes/*.cs"/>
        <Compile Include="Recovery/*.cs"/>
        <Compile Include="Reporting/*.cs"/>
        <Compile Include="Serialization/*.cs"/>
        <Compile Include="Toolchains/*.cs"/>
        <ProjectReference Include="../CMakeWorkflow.Core/CMakeWorkflow.Core.csproj"/>
        <ProjectReference Include="../CMakeWorkflow.Contracts/CMakeWorkflow.Contracts.csproj"/>
    </ItemGroup>
</Project>
