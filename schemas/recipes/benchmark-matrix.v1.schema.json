{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpp20120/CMakeWorkflow/schemas/recipes/benchmark-matrix.v1.schema.json",
  "title": "CMakeWorkflow BenchmarkMatrixRecipeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "variants", "target", "repeats", "timeoutSeconds", "fixedArguments", "axes", "executionOrder"],
  "properties": {
    "kind": { "const": "benchmark-matrix" },
    "schemaVersion": { "const": 1 },
    "variants": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/variant" } },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9_.+\\-]+$" },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
    "fixedArguments": { "type": "array", "items": { "type": "string" } },
    "axes": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/axis" } },
    "executionOrder": { "enum": ["sequential", "round-robin"] }
  },
  "$defs": {
    "variant": { "type": "object", "additionalProperties": false,
      "required": ["name", "buildDirectory"], "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "buildDirectory": { "type": "string", "minLength": 1 },
        "configuration": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.+\\-]+$" }
      } },
    "axis": { "type": "object", "additionalProperties": false,
      "required": ["name", "flag", "values"], "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "flag": { "type": "string", "pattern": "^--[^\\s\\u0000]+$" },
        "values": { "type": "array", "minItems": 1, "maxItems": 32,
          "items": { "type": "string" } }
      } }
  }
}
