{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpp20120/CMakeWorkflow/schemas/recipes/profile.v1.schema.json",
  "title": "CMakeWorkflow ProfileRecipeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "variants", "target", "repeats", "timeoutSeconds", "arguments", "backend", "mode", "platform"],
  "properties": {
    "kind": { "const": "profile" },
    "schemaVersion": { "const": 1 },
    "variants": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false,
      "required": ["name", "buildDirectory"], "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "buildDirectory": { "type": "string", "minLength": 1 }
      } } },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9_.+\\-]+$" },
    "configuration": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.+\\-]+$" },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 100 },
    "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
    "arguments": { "type": "array", "items": { "type": "string" } },
    "backend": { "enum": ["auto", "perf", "etw", "instruments"] },
    "mode": { "enum": ["cpu", "scheduler", "counters", "diagnostic"] },
    "platform": { "enum": ["linux", "windows", "macos"] },
    "sourceDirectory": { "type": ["string", "null"] },
    "configurePreset": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.+\\-]+$" }
  },
  "$comment": "Build/source paths are resolved by the CLI or must be absolute in Host requests. Backend/platform compatibility is checked by ProfileRecipeBuilder."
}
