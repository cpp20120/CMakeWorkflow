{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpp20120/CMakeWorkflow/schemas/recipes/benchmark.v1.schema.json",
  "title": "CMakeWorkflow BenchmarkRecipeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "buildDirectory",
    "target",
    "repeats",
    "timeoutSeconds",
    "arguments"
  ],
  "properties": {
    "kind": {
      "const": "benchmark"
    },
    "schemaVersion": {
      "const": 1
    },
    "buildDirectory": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+\\-]+$"
    },
    "configuration": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.+\\-]+$"
    },
    "compilerCacheProfile": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "sourceDirectory": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "configurePreset": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "timeoutSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Absolute buildDirectory and configuration semantics are checked by BenchmarkWorkflowBuilder on the execution host."
}
