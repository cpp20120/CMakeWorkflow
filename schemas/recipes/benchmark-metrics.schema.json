{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpp20120/CMakeWorkflow/schemas/recipes/benchmark-metrics.schema.json",
  "title": "CMakeWorkflow BenchmarkMetrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "format", "fields"],
  "properties": {
    "source": { "const": "stdout" },
    "format": { "const": "json" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "name", "unit", "direction"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]{1,64}(\\.[A-Za-z0-9_-]{1,64})*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "not": { "enum": ["process_wall_time", "peak_rss_bytes", "cpu_time", "artifact_result_bytes"] }
          },
          "unit": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$" },
          "direction": { "enum": ["lower-is-better", "higher-is-better"] }
        }
      }
    }
  },
  "$comment": "Field names must be unique. The extractor requires a finite JSON number at every declared path."
}
