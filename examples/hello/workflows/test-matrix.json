      "buildDirectory": "../../../out/hello",
      "configuration": "Debug",
      "configurePreset": "debug",
      "mode": "managed"
    },
    "release": {
      "sourceDirectory": "..",
      "buildDirectory": "../../../out/hello-release",
      "configuration": "Release",
      "configurePreset": "release",
      "mode": "managed"
    }
  },
  "nodes": [
