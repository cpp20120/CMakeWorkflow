{
  "schemaVersion": 2,
  "contexts": {
    "benchmark": {
      "sourceDirectory": "..",
      "buildDirectory": "../../../out/history-compare/build",
      "configuration": "Release",
      "mode": "adopt",
      "provenancePolicy": "allowUnverified"
    }
  },
  "nodes": [
    { "id": "build", "kind": "build", "context": "benchmark", "target": "median_bench" },
    { "id": "timing_001", "kind": "run", "from": "build", "resources": ["measurement-host"], "timeoutSeconds": 30 },
    { "id": "timing_002", "kind": "run", "from": "build", "dependsOn": ["timing_001"], "resources": ["measurement-host"], "timeoutSeconds": 30 },
    { "id": "timing_003", "kind": "run", "from": "build", "dependsOn": ["timing_002"], "resources": ["measurement-host"], "timeoutSeconds": 30 }
  ]
}
