<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>CMakeWorkflow.Examples.NativeFragments</PackageId>
    <Description>Reusable native build and benchmark fragments for CMakeWorkflow.</Description>
    <ScriptingVersion Condition="'$(ScriptingVersion)' == ''">0.1.0-script.1</ScriptingVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CMakeWorkflow.Scripting" Version="$(ScriptingVersion)"/>
  </ItemGroup>
</Project>
