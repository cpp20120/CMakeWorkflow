<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Program.cs"/>
        <Compile Include="Commands/CliApplication.cs"/>
        <Compile Include="Commands/DeveloperCommand.cs"/>
        <Compile Include="Commands/ClangCommand.cs"/>
        <Compile Include="Commands/KitCommand.cs"/>
        <Compile Include="Commands/ProjectSdkCommand.cs"/>
        <Compile Include="Commands/ProjectSdkResolution.cs"/>
        <Compile Include="Commands/ProjectConfigurationCommand.cs"/>
        <Compile Include="Commands/CliErrors.cs"/>
        <Compile Include="Commands/CliHistory.cs"/>
        <Compile Include="Commands/CliUsage.cs"/>
        <Compile Include="Commands/ProfileCliCommand.cs"/>
        <Compile Include="Commands/TargetCommand.cs"/>
        <Compile Include="Commands/WorkflowCliCommand.cs"/>
        <Compile Include="Commands/RemoteCommand.cs"/>
        <Compile Include="Commands/ScriptCommand.cs"/>
        <Compile Include="Commands/ExperimentCommand.cs"/>
        <Compile Include="Commands/ExperimentPlan.cs"/>
        <Compile Include="Commands/ExperimentHostSelection.cs"/>
        <Compile Include="Commands/ArtifactCasCommand.cs"/>
        <Compile Include="Commands/ArtifactCas.cs"/>
        <Compile Include="Commands/ArtifactCasJson.cs"/>
        <Compile Include="Commands/RemoteProvisionCommand.cs"/>
        <Compile Include="Commands/BenchmarkGenerateCommand.cs"/>
        <Compile Include="Commands/RecipeJson.cs" />
        <Compile Include="Commands/WorkflowRecipeGenerateCommand.cs"/>
        <Compile Include="Commands/WorkflowReportCommand.cs"/>
        <Compile Include="Commands/WorkflowHtmlReport.cs"/>
        <EmbeddedResource Include="Commands/WorkflowReport.html" LogicalName="CMakeWorkflow.WorkflowReport.html"/>
        <EmbeddedResource Include="Commands/ReportProfile.js" LogicalName="CMakeWorkflow.ReportProfile.js"/>
        <EmbeddedResource Include="Commands/ReportCharts.js" LogicalName="CMakeWorkflow.ReportCharts.js"/>
        <ProjectReference Include="CMakeWorkflow.Developer/CMakeWorkflow.Developer.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Core/CMakeWorkflow.Core.csproj"/>
        <ProjectReference Include="CMakeWorkflow.CMake/CMakeWorkflow.CMake.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Campaigns/CMakeWorkflow.Campaigns.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Profiling/CMakeWorkflow.Profiling.csproj"/>
        <ProjectReference Include="CMakeWorkflow.History/CMakeWorkflow.History.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Tooling/CMakeWorkflow.Tooling.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Host/CMakeWorkflow.Host.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Client/CMakeWorkflow.Client.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Pipelines.Coordinator/CMakeWorkflow.Pipelines.Coordinator.csproj"/>
        <ProjectReference Include="CMakeWorkflow.Sources/CMakeWorkflow.Sources.csproj"/>
        <None Update="docs/licenses/*.txt" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/%(Filename)%(Extension)"/>
        <None Update="docs/prng-notices.md" CopyToPublishDirectory="PreserveNewest" TargetPath="prng-notices.md"/>
    </ItemGroup>
    <!-- TraceEvent's ETL indexing uses reflection. Publish the decoder separately from the NativeAOT CLI. -->
    <Target Name="PublishEtwStackReader" AfterTargets="Publish"
            Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/CMakeWorkflow.EtwStackReader/CMakeWorkflow.EtwStackReader.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -p:TreatWarningsAsErrors=true -o &quot;$(PublishDir)/etw-stack-reader&quot;"/>
    </Target>
</Project>
