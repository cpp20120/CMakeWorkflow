<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WorkflowReportCommand.cs" />
    <ProjectReference Include="CMakeWorkflow.Core/CMakeWorkflow.Core.csproj" />
    <ProjectReference Include="CMakeWorkflow.CMake/CMakeWorkflow.CMake.csproj" />
    <ProjectReference Include="CMakeWorkflow.Campaigns/CMakeWorkflow.Campaigns.csproj" />
    <ProjectReference Include="CMakeWorkflow.Profiling/CMakeWorkflow.Profiling.csproj" />
    <ProjectReference Include="CMakeWorkflow.History/CMakeWorkflow.History.csproj" />
    <ProjectReference Include="CMakeWorkflow.Tooling/CMakeWorkflow.Tooling.csproj" />
    <ProjectReference Include="CMakeWorkflow.Host/CMakeWorkflow.Host.csproj" />
  </ItemGroup>
</Project>
