
root = true

[*.cs]
# Enable built-in Roslyn style diagnostics
dotnet_analyzer_diagnostic.category-Style.severity = warning

# No mandatory ConfigureAwait(false)
dotnet_diagnostic.CA2007.severity = none

# Several folder groups intentionally share one namespace (including partial types).
# Folder-based namespace fixes split those types and break compilation.
dotnet_diagnostic.IDE0130.severity = none

# CLI / developer tooling does not require resource localization
dotnet_diagnostic.CA1303.severity = none

# Preserve useful diagnostics
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.IDE0058.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# C# 12+ collection expressions
dotnet_style_prefer_collection_expression = when_types_exactly_match
dotnet_style_collection_initializer = true

# Modern constructors and object creation
# Match the build analyzer defaults explicitly in IDE/formatter workspaces.
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false
csharp_style_prefer_primary_constructors = true
csharp_style_implicit_object_creation_when_type_is_apparent = true

# Pattern matching
csharp_style_prefer_pattern_matching = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_prefer_not_pattern = true
csharp_style_prefer_extended_property_pattern = true
csharp_style_prefer_switch_expression = true

# Modern expressions
dotnet_style_coalesce_expression = true
dotnet_style_null_propagation = true
dotnet_style_prefer_compound_assignment = true
dotnet_style_prefer_conditional_expression_over_return = true
dotnet_style_prefer_conditional_expression_over_assignment = true
csharp_style_throw_expression = true
csharp_prefer_simple_default_expression = true

# Modern syntax
csharp_style_namespace_declarations = file_scoped
csharp_prefer_simple_using_statement = true
csharp_style_prefer_index_operator = true
csharp_style_prefer_range_operator = true
csharp_style_prefer_tuple_swap = true
csharp_style_prefer_utf8_string_literals = true

# Expression bodies
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_local_functions = when_on_single_line

# Cleanup
dotnet_style_object_initializer = true
dotnet_style_prefer_auto_properties = true
dotnet_style_prefer_simplified_interpolation = true

# Explicit high-priority modern syntax diagnostics
dotnet_diagnostic.IDE0290.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.IDE0066.severity = warning
dotnet_diagnostic.IDE0170.severity = warning
