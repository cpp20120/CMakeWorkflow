<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Capnp.Managed/Capnp.Managed.csproj"/>
        <Compile Condition="'$(CapnpEnableGeneration)' != 'true'" Include="../Capnp.Managed.CodeGen.Tests/Generated/Capnp.Generated.Common.g.cs" Link="Generated/Common.g.cs"/>
        <Compile Condition="'$(CapnpEnableGeneration)' != 'true'" Include="../Capnp.Managed.CodeGen.Tests/Generated/Capnp.Generated.Probe.g.cs" Link="Generated/Probe.g.cs"/>
        <Compile Include="../Capnp.Managed.CodeGen.Tests/Fixture.cs" Link="Fixture.cs"/>
    </ItemGroup>
    <PropertyGroup>
        <CapnpSourcePrefix>$(MSBuildProjectDirectory)/../Capnp.Managed.CodeGen.Tests/Schema</CapnpSourcePrefix>
    </PropertyGroup>
    <ItemGroup>
        <CapnpSchema Include="$(CapnpSourcePrefix)/common.capnp;$(CapnpSourcePrefix)/probe.capnp"/>
    </ItemGroup>
    <Import Project="../Capnp.Managed.Build/build/Capnp.Managed.targets"/>
</Project>
